[Unit]
Description=VibeScan public leaderboard (127.0.0.1:4200, behind Caddy)
Documentation=file:///home/vibescan/app/deploy/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vibescan
Group=vibescan
WorkingDirectory=/home/vibescan/app
EnvironmentFile=/etc/vibescan/public.env
ExecStart=/usr/bin/node /home/vibescan/app/server.js
Restart=on-failure
RestartSec=3

# Hardening. The public process needs exactly three things: its own source tree,
# write access to data/, and one loopback port. Note the deliberate omission of
# ReadWritePaths for anything else — a compromised public process cannot touch
# /etc, the admin env file, or the rest of the filesystem.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/vibescan/app/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=no
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute=yes is deliberately NOT set: V8 compiles JS to
# executable memory at runtime (W^X toggle), so the sandbox kills node with
# SIGTRAP during startup (SetPermissionsOnExecutableMemoryChunk). If you ever
# want it back you must also run node with --jitless, which costs ~2-4x CPU.
#SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

# Logging: journald, rate-limited so a scan loop cannot flood the disk.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
