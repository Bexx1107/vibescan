# Public instance env — /etc/vibescan/public.env  (chmod 0640, root:vibescan)
#
# The public process is a DIFFERENT process from the internal scanner, with its
# own data dir. Do not copy .env from the laptop: that one carries
# VIBESCAN_ALLOW_INSECURE=1 and points at un-redacted reports.
#
# Bind loopback only. Caddy on the same host is the sole ingress; nothing here
# should ever be reachable from the internet directly.

HOST=127.0.0.1
PORT=4200

# Public leaderboard mode: reads AND writes open ("anyone can submit, any time").
# Writes are gated by the per-IP token buckets in lib/leaderboard.js, keyed on
# X-Real-IP set by Caddy — not on the spoofable left-most X-Forwarded-For.
VIBESCAN_PUBLIC=1

# Required as soon as HOST is not 127.0.0.1; set anyway so the internal routes
# (/api/jobs, /api/report) stay closed to the public even if HOST is changed by
# mistake later. Generate with: openssl rand -hex 32
VIBESCAN_TOKEN=__GENERATE_ME__

# NEVER set this on a public instance. The server prints a loud warning and
# serves un-redacted reports.
# VIBESCAN_ALLOW_INSECURE=1

# Canonical origin, so OG cards and canonicals never hard-code a host.
PUBLIC_BASE_URL=https://your-domain.example
