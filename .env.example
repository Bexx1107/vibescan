# VibeScan environment template
# Copy to .env (chmod 600) or use an external systemd EnvironmentFile.

# Listener bind & port (keep 127.0.0.1 when running behind Caddy/Nginx)
HOST=127.0.0.1
PORT=4200

# Set to 1 to expose the public leaderboard + open submission routes (rate-limited per IP)
VIBESCAN_PUBLIC=0

# Required when HOST is non-loopback (or set to keep internal routes closed behind a reverse proxy)
# Generate with: openssl rand -hex 32
# VIBESCAN_TOKEN=

# Optional isolated worker pool tuning
VIBESCAN_CONCURRENCY=2
VIBESCAN_JOB_TIMEOUT_MS=120000
VIBESCAN_MAX_QUEUED=25

# Canonical public URL used for metadata
PUBLIC_BASE_URL=https://your-domain.example

# Optional outbound HTTP proxy tier chain for scanner requests
# SCANNER_EGRESS=vpn=http://127.0.0.1:8888,res=http://127.0.0.1:8889
# SCANNER_ALLOW_DIRECT=0

# Optional Firecrawl API key for anti-bot/SPA fallback extraction
# FIRECRAWL_API_KEY=
